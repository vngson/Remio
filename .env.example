# URL công khai của ứng dụng, dùng để tạo link trong email nhắc nhở.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chuỗi kết nối Postgres qua pooler ở chế độ transaction (cổng 6543) — dùng khi chạy app.
DATABASE_URL=

# Kết nối trực tiếp (hoặc session pooler, cổng 5432) — chỉ dùng khi chạy migration.
# Nếu bỏ trống, migration sẽ dùng DATABASE_URL.
DIRECT_URL=

# Chuỗi bí mật dùng cho endpoint cron. Tạo bằng: openssl rand -hex 32
CRON_SECRET=

# Gmail SMTP: cần bật xác thực 2 bước rồi tạo App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
